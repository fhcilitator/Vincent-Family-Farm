{
  "expo": {
    "name": "vibe agent",
    "slug": "vff-vibe-agent",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vffagent",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["android"],
    "android": {
      "package": "com.vincentfamilyfarm.vibeagent",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@jamsch/expo-speech-recognition",
        {
          "microphonePermission": "Dictate prompts instead of typing them on a phone keyboard.",
          "speechRecognitionPermission": "Turn what you say into a prompt you can read and edit before sending."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
