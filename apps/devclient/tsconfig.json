{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@vff/client-core": ["../../packages/client-core/src/index.ts"],
      "@vff/protocol": ["../../packages/protocol/src/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
